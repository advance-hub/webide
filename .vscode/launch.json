{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "工作台控制面",
      "type": "node",
      "request": "launch",
      "runtimeArgs": [
        "--env-file-if-exists=application/.env",
        "--import",
        "tsx"
      ],
      "program": "${workspaceFolder}/application/server/main.ts",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "独立 IDE 服务",
      "type": "node",
      "request": "launch",
      "runtimeArgs": [
        "--max-old-space-size=512"
      ],
      "program": "${workspaceFolder}/server/dist/main.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "MY_WORKSPACE": "${workspaceFolder}/tools/workspace",
        "ENABLE_AI": "1"
      }
    },
    {
      "name": "当前框架测试",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run-jest.js",
      "args": [
        "--runTestsByPath",
        "${file}",
        "--detectOpenHandles"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true
    },
    {
      "name": "当前产品测试",
      "type": "node",
      "request": "launch",
      "runtimeArgs": [
        "--import",
        "tsx",
        "--test"
      ],
      "program": "${file}",
      "cwd": "${workspaceFolder}/application",
      "console": "integratedTerminal"
    }
  ]
}
