{
  "name": "@opensumi/ide-electron",
  "version": "1.1.0",
  "description": "IDE Electron 实践层",
  "main": "./app/dist/main/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "link-local": "node ./scripts/link-local.js",
    "build:browser": "rspack build --config ./build/rspack.browser.config.js",
    "build:node": "rspack build --config ./build/rspack.node.config.js",
    "build:extension": "rspack build --config ./build/rspack.extension-host.config.js",
    "build:main": "rspack build --config ./build/rspack.main.config.js",
    "build:webview": "rspack build --config ./build/rspack.webview.config.js",
    "build-prod:browser": "rspack build --config ./build/rspack.browser.config.js --mode=production",
    "build-prod:node": "rspack build --config ./build/rspack.node.config.js --mode=production",
    "build-prod:extension": "rspack build --config ./build/rspack.extension-host.config.js --mode=production",
    "build-prod:main": "rspack build --config ./build/rspack.main.config.js --mode=production",
    "build-prod:webview": "rspack build --config ./build/rspack.webview.config.js --mode=production",
    "watch:browser": "rspack build --config ./build/rspack.browser.config.js -w --mode=development",
    "watch:node": "rspack build --config ./build/rspack.node.config.js -w --mode=development",
    "watch:extension": "rspack build --config ./build/rspack.extension-host.config.js -w --mode=development",
    "watch:main": "rspack build --config ./build/rspack.main.config.js -w --mode=development",
    "watch:webview": "rspack build --config ./build/rspack.webview.config.js -w --mode=development",
    "watch": "run-p \"watch:*\"",
    "build": "pnpm run typecheck && rimraf ./out && run-s \"build:*\"",
    "build-prod": "pnpm run typecheck && rimraf ./out && run-s \"build-prod:*\"",
    "pack": "pnpm run build && node build/pack.js",
    "rebuild-native": "sumi rebuild --target=electron",
    "start": "electron --inspect=9229 .",
    "start:no-dev": "electron .",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:opensumi/ide-electron.git"
  },
  "author": "",
  "license": "ISC",
