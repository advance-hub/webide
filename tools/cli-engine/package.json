{
  "name": "@opensumi/cli-engine",
  "version": "3.9.0",
  "description": "Integration engine runtime for opensumi-cli and opensumi extension",
  "license": "MIT",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "pnpm run typecheck && cross-env NODE_ENV=production run-s build:node build:browser build:exthost build:webview build:ext-worker-host",
    "build:browser": "rspack build --config ./configs/rspack.config.browser.js",
    "build:ext-worker-host": "rspack build --config ./configs/rspack.config.ext-worker.js",
    "build:ext-worker-host:watch": "pnpm run build:ext-worker-host -- --watch",
    "build:exthost": "rspack build --config ./configs/rspack.config.ext.js",
    "build:webview": "rspack build --config ./configs/rspack.config.webview.js",
    "build:node": "tsc -p configs/tsconfig.node.json",
    "lint": "eslint --cache --ext .js ./",
    "lint:fix": "pnpm run lint -- --fix",
    "prepublishOnly": "pnpm run build",
    "watch": "cross-env NODE_ENV=development run-p watch:node watch:browser watch:exthost watch:webview watch:ext-worker-host",
    "watch:browser": "pnpm run build:browser -- --watch",
    "watch:exthost": "pnpm run build:exthost -- --watch",
    "watch:node": "tsc -w -p configs/tsconfig.node.json",
    "watch:webview": "pnpm run build:webview -- --watch",
    "typecheck": "tsc -p configs/tsconfig.check.json"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@opensumi/di": "^1.8.0",
    "@opensumi/ide-core-browser": "workspace:*",
    "@opensumi/ide-core-common": "workspace:*",
    "@opensumi/ide-core-node": "workspace:*",
    "@opensumi/ide-express-file-server": "workspace:*",
    "@opensumi/ide-extension": "workspace:*",
    "@opensumi/ide-i18n": "workspace:*",
    "@opensumi/ide-main-layout": "workspace:*",
    "@opensumi/ide-startup": "workspace:*",
    "chalk": "^4.1.2",
    "ejs": "^3.1.7",
    "koa": "3.2.1",
    "koa-mount": "^4.2.0",
    "mri": "^1.2.0",
    "open": "^7.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/ejs": "^3.0.2",
    "@types/koa-mount": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.5",
    "less": "^4.9.1",
    "less-loader": "^13.0.0",
    "loader-utils": "^1.2.3",
    "npm-run-all": "^4.1.5",
    "shell-path": "^2.1.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "@rspack/core": "2.2.8",
    "@rspack/cli": "2.2.8",
    "@opensumi/ide-dev-tool": "workspace:*",
    "buffer": "^6.0.3",
    "process": "^0.11.10",
    "path-browserify": "^1.0.1",
    "util": "^0.12.5",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
