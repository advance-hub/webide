{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "preserve",
    "skipLibCheck": true,
    "types": ["node"],
    "noEmitOnError": true,
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "declaration": true,
    "outDir": "../lib/node"
  },
  "include": ["../src/node"],
  "exclude": ["node_modules", "../lib"]
}
