# 本机工作台，演示模式只监听回环地址。
WORKBENCH_HOST=127.0.0.1
WORKBENCH_PORT=8790
WORKBENCH_LOCAL_DEMO=1
WORKBENCH_RUNTIME_DRIVER=local
WORKBENCH_MACHINE_LIMIT=20
OPENSUMI_NODE_WATCHER_MODE=per-client

# 可选覆盖项；留空时采用 docs/RUNNING.md 中的默认值。
WORKBENCH_DATA_DIR=
WORKBENCH_PUBLIC_URL=
WORKBENCH_IDE_HOST=localhost
WORKBENCH_ADMIN_USERS=
WORKBENCH_DOCKER_CONTEXT=

# OpenSandbox 需要单独部署服务与工作区镜像。
OPEN_SANDBOX_URL=
OPEN_SANDBOX_API_KEY=
OPEN_SANDBOX_IMAGE=
OPEN_SANDBOX_CPU=2
OPEN_SANDBOX_MEMORY=2Gi
# ARM64 Docker 主机运行 x64 工作区镜像时设置 linux/amd64。
OPEN_SANDBOX_PLATFORM=
OPEN_SANDBOX_REQUEST_TIMEOUT_SECONDS=300
WORKBENCH_STORAGE_MODE=pvc
WORKBENCH_STORAGE_CLASS=
WORKBENCH_VOLUME_BACKEND=external
# Git 凭据桥地址需要允许沙箱访问，非演示模式必须使用 HTTPS。
WORKBENCH_GIT_BRIDGE_URL=
# Kubernetes 卷删除使用命名空间内服务账户，仅需 PVC 查询/删除与 Pod 列表权限。
WORKBENCH_KUBERNETES_URL=
WORKBENCH_KUBERNETES_NAMESPACE=default
WORKBENCH_KUBERNETES_TOKEN_FILE=
WORKBENCH_KUBERNETES_CA_FILE=
