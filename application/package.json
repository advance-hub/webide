{
  "name": "@opensumi/application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "dev:client": "rspack dev --config rspack.config.ts",
    "build": "pnpm run typecheck && pnpm run build:client && pnpm run build:server",
    "start": "node server/main.mjs",
    "test": "tsx --test server/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:client": "rspack build --config rspack.config.ts",
    "build:server": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../scripts/build-application-server.ts"
  },
  "dependencies": {
    "@alibaba-group/opensandbox": "1.1.0",
    "@arco-design/web-react": "2.66.16",
    "@koa/router": "^15.7.0",
    "cos-nodejs-sdk-v5": "3.0.0",
    "koa": "3.2.1",
    "koa-static": "^5.0.0",
    "mysql2": "3.24.5",
    "tar": "7.5.22",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@rspack/cli": "2.2.8",
    "@rspack/core": "2.2.8",
    "@rspack/dev-server": "2.2.1",
    "@types/koa": "3.0.3",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "css-loader": "^7.1.5",
    "style-loader": "^4.0.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
