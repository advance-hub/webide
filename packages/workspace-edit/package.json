{
  "name": "@opensumi/ide-workspace-edit",
  "version": "3.9.0",
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsc --build ../../configs/ts/references/tsconfig.workspace-edit.json"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:opensumi/core.git"
  },
  "dependencies": {
    "@opensumi/ide-components": "workspace:*",
    "@opensumi/ide-core-browser": "workspace:*",
    "@opensumi/ide-core-common": "workspace:*",
    "@opensumi/ide-editor": "workspace:*",
    "@opensumi/ide-file-service": "workspace:*",
    "@opensumi/ide-main-layout": "workspace:*",
    "@opensumi/ide-monaco": "workspace:*",
    "@opensumi/ide-overlay": "workspace:*",
    "tslib": "^2.8.1",
    "@opensumi/di": "^1.8.0",
    "@opensumi/monaco-editor-core": "0.54.0-patch.2"
  },
  "devDependencies": {
    "@opensumi/ide-dev-tool": "workspace:*"
  },
  "exports": {
    ".": {
      "opensumi-source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "opensumi-source": "./src/common/index.ts",
      "types": "./lib/common/index.d.ts",
      "default": "./lib/common/index.js"
    },
    "./browser": {
      "opensumi-source": "./src/browser/index.ts",
      "types": "./lib/browser/index.d.ts",
      "default": "./lib/browser/index.js"
    },
    "./files": {
      "opensumi-source": "./src/browser/workspace-file.service.ts",
      "types": "./lib/browser/workspace-file.service.d.ts",
      "default": "./lib/browser/workspace-file.service.js"
    },
    "./bulk-edit": {
      "opensumi-source": "./src/browser/bulk-edit.service.ts",
      "types": "./lib/browser/bulk-edit.service.d.ts",
      "default": "./lib/browser/bulk-edit.service.js"
    },
    "./service": {
      "opensumi-source": "./src/browser/workspace-edit.service.ts",
      "types": "./lib/browser/workspace-edit.service.d.ts",
      "default": "./lib/browser/workspace-edit.service.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  }
}
