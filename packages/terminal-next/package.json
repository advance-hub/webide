      "opensumi-source": "./src/browser/terminal.view.ts",
      "types": "./lib/browser/terminal.view.d.ts",
      "default": "./lib/browser/terminal.view.js"
    },
    "./package.json": "./package.json",
    "./hover": {
      "opensumi-source": "./src/common/hover.ts",
      "types": "./lib/common/hover.d.ts",
      "default": "./lib/common/hover.js"
    }
  },
  "peerDependencies": {
    "react": "^18.3.1"
  }
}
