{
  "name": "@opensumi/ide-workspace",
  "version": "3.9.0",
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsc --build ../../configs/ts/references/tsconfig.workspace.json"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:opensumi/core.git"
  },
  "dependencies": {
    "@opensumi/ide-core-browser": "workspace:*",
    "@opensumi/ide-core-common": "workspace:*",
    "@opensumi/ide-file-service": "workspace:*",
    "@opensumi/ide-overlay": "workspace:*",
    "@opensumi/di": "^1.8.0",
    "tslib": "^2.6.2",
    "ajv": "^8.17.1",
    "jsonc-parser": "^2.1.0"
  },
  "devDependencies": {
    "@opensumi/ide-dev-tool": "workspace:*"
  },
  "exports": {
    ".": {
      "opensumi-source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./browser": {
      "opensumi-source": "./src/browser/index.ts",
      "types": "./lib/browser/index.d.ts",
      "default": "./lib/browser/index.js"
    },
    "./service": {
      "opensumi-source": "./src/browser/workspace-service.ts",
      "types": "./lib/browser/workspace-service.d.ts",
      "default": "./lib/browser/workspace-service.js"
    },
    "./preferences": {
      "opensumi-source": "./src/browser/workspace-preferences.ts",
      "types": "./lib/browser/workspace-preferences.d.ts",
      "default": "./lib/browser/workspace-preferences.js"
    },
    "./variables": {
      "opensumi-source": "./src/browser/workspace-variable-contribution.ts",
      "types": "./lib/browser/workspace-variable-contribution.d.ts",
      "default": "./lib/browser/workspace-variable-contribution.js"
    },
    "./data": {
      "opensumi-source": "./src/browser/workspace-data.ts",
      "types": "./lib/browser/workspace-data.d.ts",
      "default": "./lib/browser/workspace-data.js"
    },
    "./package.json": "./package.json"
  }
}
