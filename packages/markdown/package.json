{
  "name": "@opensumi/ide-markdown",
  "version": "3.9.0",
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsc --build ../../configs/ts/references/tsconfig.markdown.json"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:opensumi/core.git"
  },
  "dependencies": {
    "@opensumi/ide-components": "workspace:*",
    "@opensumi/ide-core-browser": "workspace:*",
    "@opensumi/ide-core-common": "workspace:*",
    "@opensumi/ide-editor": "workspace:*",
    "@opensumi/ide-webview": "workspace:*",
    "tslib": "^2.6.2",
    "@opensumi/di": "^1.8.0"
  },
  "devDependencies": {
    "@opensumi/ide-dev-tool": "workspace:*"
  },
  "exports": {
    ".": {
      "opensumi-source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "opensumi-source": "./src/common/index.ts",
      "types": "./lib/common/index.d.ts",
      "default": "./lib/common/index.js"
    },
    "./browser": {
      "opensumi-source": "./src/browser/index.ts",
      "types": "./lib/browser/index.d.ts",
      "default": "./lib/browser/index.js"
    },
    "./editor": {
      "opensumi-source": "./src/browser/editor.markdown.tsx",
      "types": "./lib/browser/editor.markdown.d.ts",
      "default": "./lib/browser/editor.markdown.js"
    },
    "./contribution": {
      "opensumi-source": "./src/browser/contribution.ts",
      "types": "./lib/browser/contribution.d.ts",
      "default": "./lib/browser/contribution.js"
    },
    "./service": {
      "opensumi-source": "./src/browser/markdown.service.ts",
      "types": "./lib/browser/markdown.service.d.ts",
      "default": "./lib/browser/markdown.service.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  }
}
