{
  "name": "@opensumi/ide-output",
  "version": "3.9.0",
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsc --build ../../configs/ts/references/tsconfig.output.json"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:opensumi/core.git"
  },
  "dependencies": {
    "@opensumi/ide-components": "workspace:*",
    "@opensumi/ide-core-browser": "workspace:*",
    "@opensumi/ide-core-common": "workspace:*",
    "@opensumi/ide-editor": "workspace:*",
    "@opensumi/ide-main-layout": "workspace:*",
    "@opensumi/ide-monaco": "workspace:*",
    "@opensumi/ide-workspace": "workspace:*",
    "tslib": "^2.8.1",
    "@opensumi/di": "^1.8.0",
    "@opensumi/monaco-editor-core": "0.54.0-patch.2"
  },
  "devDependencies": {
    "@opensumi/ide-dev-tool": "workspace:*"
  },
  "exports": {
    ".": {
      "opensumi-source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./browser": {
      "opensumi-source": "./src/browser/index.ts",
      "types": "./lib/browser/index.d.ts",
      "default": "./lib/browser/index.js"
    },
    "./service": {
      "opensumi-source": "./src/browser/output.service.ts",
      "types": "./lib/browser/output.service.d.ts",
      "default": "./lib/browser/output.service.js"
    },
    "./channel": {
      "opensumi-source": "./src/browser/output.channel.ts",
      "types": "./lib/browser/output.channel.d.ts",
      "default": "./lib/browser/output.channel.js"
    },
    "./preferences": {
      "opensumi-source": "./src/browser/output-preference.ts",
      "types": "./lib/browser/output-preference.d.ts",
      "default": "./lib/browser/output-preference.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  }
}
