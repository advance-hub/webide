{
  "name": "@opensumi/ide-startup",
  "version": "3.9.0",
  "files": [
    "lib",
    "src",
    "bootstrap"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "start:lite": "rspack dev --config ./rspack.lite.config.js",
    "start": "run-p start:client:open start:server",
    "start:e2e": "run-p start:client:e2e start:server:e2e",
    "start:client": "rspack dev --config ./rspack.config.js",
    "start:server": "cross-env IS_DEV=1 NODE_ENV=development EXT_MODE=js KTLOG_SHOW_DEBUG=1 nodemon --inspect=9999 ./entry/web/server.ts",
    "start:server:e2e": "cross-env IS_DEV=1 NODE_ENV=development EXT_MODE=js KTLOG_SHOW_DEBUG=1 EXTENSION_HOST_IDLE_TIMEOUT=1000 nodemon --inspect=9999 ./entry/web/server.ts",
    "start:no-inspect:client": "pnpm run start:client",
    "start:no-inspect:server": "cross-env EXT_MODE=js KTLOG_SHOW_DEBUG=1 nodemon ./entry/web/server.ts",
    "start:client:open": "cross-env SUMI_DEV_OPEN_BROWSER=1 pnpm run start:client",
    "start:client:e2e": "cross-env NODE_OPTIONS=--max-old-space-size=1024 OPENSUMI_E2E_MODE=1 OPENSUMI_E2E_COMMANDS=true SUPPORT_LOAD_WORKSPACE_BY_HASH=true KTLOG_SHOW_DEBUG=1 node ../../node_modules/@rspack/cli/bin/rspack.js dev --config ../../client/rspack.config.ts",
    "start:server:extjs": "cross-env EXT_MODE=js NODE_ENV=development KTLOG_SHOW_DEBUG=1 NODE_OPTIONS='--import tsx' node --inspect=9999 ./entry/web/server.ts",
    "build": "tsc --build ../../configs/ts/references/tsconfig.startup.json",
    "bundle:standard": "cross-env NODE_ENV=production rspack build --config rspack.standard.config.js",
    "bundle:standard:analysis": "cross-env analysis=1 pnpm run bundle:standard",
    "bundle:lite": "cross-env NODE_ENV=production rspack build --config rspack.lite.config.js",
    "bundle:lite:stats": "cross-env NODE_ENV=production RSPACK_PROFILE=1 rspack build --config rspack.lite.config.js --json stats.json",
    "bundle:lite:analysis": "cross-env analysis=1 pnpm run bundle:lite",
    "bundle:preview": "rspack build --config rspack.preview.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:opensumi/core.git"
  },
  "nodemonConfig": {
    "restartable": "rs",
    "ignore": [
      ".git",
      "**/lib/**",
      "**/node_modules/**",
      "**/__tests__/**",
      "**/src/browser/**",
      "**/core-browser/**",
      "**/extensions/common/**",
      "**/theme/**",
      "**/src/hosted/**",
      "**/*.d.ts"
    ],
    "verbose": true,
    "execMap": {
      "ts": "node --require ts-node/register"
    },
    "watch": [
      "../../packages"
    ],
    "events": {
      "crash": "kill -9 $(lsof -t -i:8000 -sTCP:LISTEN)"
    },
    "signal": "SIGTERM",
    "ext": "js,json,ts",
    "delay": "2000"
  },
  "dependencies": {
    "@opensumi/ide-addons": "workspace:*",
    "@opensumi/ide-ai-native": "workspace:*",
    "@opensumi/ide-collaboration": "workspace:*",
    "@opensumi/ide-comments": "workspace:*",
    "@opensumi/ide-components": "workspace:*",
    "@opensumi/ide-core-browser": "workspace:*",
    "@opensumi/ide-core-common": "workspace:*",
    "@opensumi/ide-core-node": "workspace:*",
    "@opensumi/ide-debug": "workspace:*",
    "@opensumi/ide-decoration": "workspace:*",
    "@opensumi/ide-design": "workspace:*",
    "@opensumi/ide-dev-tool": "workspace:*",
    "@opensumi/ide-editor": "workspace:*",
    "@opensumi/ide-explorer": "workspace:*",
    "@opensumi/ide-express-file-server": "workspace:*",
    "@opensumi/ide-extension": "workspace:*",
    "@opensumi/ide-extension-manager": "workspace:*",
    "@opensumi/ide-extension-storage": "workspace:*",
    "@opensumi/ide-file-scheme": "workspace:*",
    "@opensumi/ide-file-search": "workspace:*",
    "@opensumi/ide-file-service": "workspace:*",
    "@opensumi/ide-file-tree-next": "workspace:*",
    "@opensumi/ide-i18n": "workspace:*",
    "@opensumi/ide-keymaps": "workspace:*",
    "@opensumi/ide-logs": "workspace:*",
    "@opensumi/ide-main-layout": "workspace:*",
    "@opensumi/ide-markdown": "workspace:*",
    "@opensumi/ide-markers": "workspace:*",
    "@opensumi/ide-menu-bar": "workspace:*",
    "@opensumi/ide-monaco": "workspace:*",
    "@opensumi/ide-monaco-enhance": "workspace:*",
    "@opensumi/ide-notebook": "workspace:*",
    "@opensumi/ide-opened-editor": "workspace:*",
    "@opensumi/ide-outline": "workspace:*",
    "@opensumi/ide-output": "workspace:*",
    "@opensumi/ide-overlay": "workspace:*",
    "@opensumi/ide-preferences": "workspace:*",
    "@opensumi/ide-process": "workspace:*",
    "@opensumi/ide-quick-open": "workspace:*",
    "@opensumi/ide-remote-opener": "workspace:*",
    "@opensumi/ide-scm": "workspace:*",
    "@opensumi/ide-search": "workspace:*",
    "@opensumi/ide-status-bar": "workspace:*",
    "@opensumi/ide-storage": "workspace:*",
    "@opensumi/ide-task": "workspace:*",
    "@opensumi/ide-terminal-next": "workspace:*",
    "@opensumi/ide-testing": "workspace:*",
    "@opensumi/ide-theme": "workspace:*",
    "@opensumi/ide-toolbar": "workspace:*",
    "@opensumi/ide-variable": "workspace:*",
    "@opensumi/ide-webview": "workspace:*",
    "@opensumi/ide-workspace": "workspace:*",
    "@opensumi/ide-workspace-edit": "workspace:*",
    "@opensumi/textmate-languages": "^2.8.1",
    "tslib": "^2.8.1",
    "@opensumi/di": "^1.8.0",
    "@opensumi/monaco-editor-core": "0.54.0-patch.2"
  },
  "devDependencies": {
    "browserfs": "^1.4.3",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.5",
    "less-loader": "^13.0.0",
    "nodemon": "^2.0.15",
    "npm-run": "^5.0.1",
    "npm-run-all": "^4.1.5",
    "react-dom": "18.3.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "webpack-bundle-analyzer": "^4.10.1",
    "@rspack/core": "2.2.8",
    "@rspack/cli": "2.2.8"
  },
  "exports": {
    ".": {
      "opensumi-source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./browser": {
      "opensumi-source": "./src/browser/index.ts",
      "types": "./lib/browser/index.d.ts",
      "default": "./lib/browser/index.js"
    },
    "./browser/modules": {
      "opensumi-source": "./src/browser/common-modules.ts",
      "types": "./lib/browser/common-modules.d.ts",
      "default": "./lib/browser/common-modules.js"
    },
    "./browser/ai": {
      "opensumi-source": "./src/browser/ai-modules.ts",
      "types": "./lib/browser/ai-modules.d.ts",
      "default": "./lib/browser/ai-modules.js"
    },
    "./browser/notebook": {
      "opensumi-source": "./src/browser/notebook-modules.ts",
      "types": "./lib/browser/notebook-modules.d.ts",
      "default": "./lib/browser/notebook-modules.js"
    },
    "./browser/collaboration": {
      "opensumi-source": "./src/browser/collaboration-modules.ts",
      "types": "./lib/browser/collaboration-modules.d.ts",
      "default": "./lib/browser/collaboration-modules.js"
    },
    "./browser/menu-help": {
      "opensumi-source": "./src/browser/menu-bar-help-icon.tsx",
      "types": "./lib/browser/menu-bar-help-icon.d.ts",
      "default": "./lib/browser/menu-bar-help-icon.js"
    },
    "./node/modules": {
      "opensumi-source": "./src/node/common-modules.ts",
      "types": "./lib/node/common-modules.d.ts",
      "default": "./lib/node/common-modules.js"
    },
    "./node/ai": {
      "opensumi-source": "./src/node/ai-modules.ts",
      "types": "./lib/node/ai-modules.d.ts",
      "default": "./lib/node/ai-modules.js"
    },
    "./node/collaboration": {
      "opensumi-source": "./src/node/collaboration-modules.ts",
      "types": "./lib/node/collaboration-modules.d.ts",
      "default": "./lib/node/collaboration-modules.js"
    },
    "./runtime-mode": {
      "types": "./bootstrap/runtime-mode.d.cts",
      "default": "./bootstrap/runtime-mode.cjs"
    },
    "./package.json": "./package.json",
    "./browser/render": {
      "opensumi-source": "./src/browser/renderer/index.tsx",
      "types": "./lib/browser/renderer/index.d.ts",
      "default": "./lib/browser/renderer/index.js"
    },
    "./browser/cloud-dev": {
      "opensumi-source": "./src/browser/cloud-dev.module.ts",
      "types": "./lib/browser/cloud-dev.module.d.ts",
      "default": "./lib/browser/cloud-dev.module.js"
    },
    "./examples": {
      "opensumi-source": "./src/browser/examples/index.ts",
      "types": "./lib/browser/examples/index.d.ts",
      "default": "./lib/browser/examples/index.js"
    },
    "./examples/base": {
      "opensumi-source": "./src/browser/examples/base.ts",
      "types": "./lib/browser/examples/base.d.ts",
      "default": "./lib/browser/examples/base.js"
    },
    "./examples/ai": {
      "opensumi-source": "./src/browser/examples/ai-module.ts",
      "types": "./lib/browser/examples/ai-module.d.ts",
      "default": "./lib/browser/examples/ai-module.js"
    }
  },
  "peerDependencies": {
    "react": "^18.3.1"
  }
}
