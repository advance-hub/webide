{
  "name": "@opensumi/ide-utils",
  "version": "3.9.0",
  "files": [
    "lib",
    "src"
  ],
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "exports": {
    ".": {
      "opensumi-source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./argv": {
      "opensumi-source": "./src/argv.ts",
      "types": "./lib/argv.d.ts",
      "default": "./lib/argv.js"
    },
    "./arrays": {
      "opensumi-source": "./src/arrays.ts",
      "types": "./lib/arrays.d.ts",
      "default": "./lib/arrays.js"
    },
    "./icon-labels": {
      "opensumi-source": "./src/iconLabels.ts",
      "types": "./lib/iconLabels.d.ts",
      "default": "./lib/iconLabels.js"
    },
    "./objects": {
      "opensumi-source": "./src/objects.ts",
      "types": "./lib/objects.d.ts",
      "default": "./lib/objects.js"
    },
    "./path": {
      "opensumi-source": "./src/path.ts",
      "types": "./lib/path.d.ts",
      "default": "./lib/path.js"
    },
    "./stream": {
      "opensumi-source": "./src/stream.ts",
      "types": "./lib/stream.d.ts",
      "default": "./lib/stream.js"
    },
    "./strings": {
      "opensumi-source": "./src/strings.ts",
      "types": "./lib/strings.d.ts",
      "default": "./lib/strings.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsc --build ../../configs/ts/references/tsconfig.utils.json"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:opensumi/core.git"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "jschardet": "3.0.0",
    "lodash": "^4.17.21",
    "mri": "^1.2.0",
    "nanoid": "3.3.18",
    "tslib": "^2.6.2",
    "vscode-uri": "3.0.2"
  },
  "devDependencies": {
    "@opensumi/ide-dev-tool": "workspace:*"
  }
}
