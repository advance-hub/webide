{
  "name": "@opensumi/ide-extension",
  "version": "3.9.0",
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "pnpm run build:pkg && pnpm run build:ext-host && pnpm run compile:worker",
    "build:pkg": "tsc --build ../../configs/ts/references/tsconfig.extension.json",
    "compile:worker": "cross-env NODE_OPTIONS=\"--max-old-space-size=512 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON\" rspack build --config rspack.config.worker.ts",
    "watch:worker": "cross-env NODE_OPTIONS=\"--max-old-space-size=512 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON\" rspack build --watch --config rspack.config.worker.ts",
    "build:ext-host": "tsc -p ../../configs/ts/references/tsconfig.extension.json",
    "watch:ext-host": "tsc --watch -p ../../configs/ts/references/tsconfig.extension.json"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:opensumi/core.git"
  },
  "dependencies": {
    "@opensumi/events": "^1.0.0",
    "@opensumi/ide-ai-native": "workspace:*",
    "@opensumi/ide-comments": "workspace:*",
    "@opensumi/ide-components": "workspace:*",
    "@opensumi/ide-connection": "workspace:*",
    "@opensumi/ide-core-browser": "workspace:*",
    "@opensumi/ide-core-common": "workspace:*",
    "@opensumi/ide-core-node": "workspace:*",
    "@opensumi/ide-debug": "workspace:*",
    "@opensumi/ide-decoration": "workspace:*",
    "@opensumi/ide-editor": "workspace:*",
    "@opensumi/ide-extension-storage": "workspace:*",
    "@opensumi/ide-file-search": "workspace:*",
    "@opensumi/ide-file-service": "workspace:*",
    "@opensumi/ide-file-tree-next": "workspace:*",
    "@opensumi/ide-i18n": "workspace:*",
    "@opensumi/ide-logs": "workspace:*",
    "@opensumi/ide-main-layout": "workspace:*",
    "@opensumi/ide-markdown": "workspace:*",
    "@opensumi/ide-monaco": "workspace:*",
    "@opensumi/ide-output": "workspace:*",
    "@opensumi/ide-overlay": "workspace:*",
    "@opensumi/ide-quick-open": "workspace:*",
    "@opensumi/ide-scm": "workspace:*",
    "@opensumi/ide-task": "workspace:*",
    "@opensumi/ide-terminal-next": "workspace:*",
    "@opensumi/ide-testing": "workspace:*",
    "@opensumi/ide-theme": "workspace:*",
    "@opensumi/ide-toolbar": "workspace:*",
    "@opensumi/ide-utils": "workspace:*",
    "@opensumi/ide-webview": "workspace:*",
    "@opensumi/ide-workspace": "workspace:*",
    "@opensumi/ide-workspace-edit": "workspace:*",
    "address": "^1.1.2",
    "glob-to-regexp": "0.4.1",
    "is-running": "^2.1.0",
    "picomatch": "^2.2.1",
    "semver": "^7.5.2",
    "tree-kill": "^1.2.2",
    "v8-inspect-profiler": "^0.1.1",
    "tslib": "^2.8.1",
    "@opensumi/di": "^1.8.0",
    "lodash": "^4.17.21",
    "fs-extra": "^11.4.1",
    "vscode-languageserver-types": "^3.18.4",
    "@opensumi/monaco-editor-core": "0.54.0-patch.2",
    "classnames": "2.5.1",
    "vscode-uri": "3.2.0",
    "@opensumi/vscode-debugprotocol": "1.49.0-beta.1",
    "rc-input-number": "^9.5.0"
  },
  "devDependencies": {
    "@opensumi/ide-dev-tool": "workspace:*",
    "@rspack/cli": "2.2.8",
    "@rspack/core": "2.2.8",
    "ts-loader": "^9.6.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "exports": {
    ".": {
      "opensumi-source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./browser": {
      "opensumi-source": "./src/browser/index.ts",
      "types": "./lib/browser/index.d.ts",
      "default": "./lib/browser/index.js"
    },
    "./node": {
      "opensumi-source": "./src/node/index.ts",
      "types": "./lib/node/index.d.ts",
      "default": "./lib/node/index.js"
    },
    "./browser/types": {
      "opensumi-source": "./src/browser/types.ts",
      "types": "./lib/browser/types.d.ts",
      "default": "./lib/browser/types.js"
    },
    "./browser/management": {
      "opensumi-source": "./src/browser/extension-management.service.ts",
      "types": "./lib/browser/extension-management.service.d.ts",
      "default": "./lib/browser/extension-management.service.js"
    },
    "./browser/node-host": {
      "opensumi-source": "./src/browser/extension-node.service.ts",
      "types": "./lib/browser/extension-node.service.d.ts",
      "default": "./lib/browser/extension-node.service.js"
    },
    "./services": {
      "opensumi-source": "./src/common/extension.service.ts",
      "types": "./lib/common/extension.service.d.ts",
      "default": "./lib/common/extension.service.js"
    },
    "./vscode": {
      "opensumi-source": "./src/common/vscode/index.ts",
      "types": "./lib/common/vscode/index.d.ts",
      "default": "./lib/common/vscode/index.js"
    },
    "./vscode/types": {
      "opensumi-source": "./src/common/vscode/ext-types.ts",
      "types": "./lib/common/vscode/ext-types.d.ts",
      "default": "./lib/common/vscode/ext-types.js"
    },
    "./vscode/converter": {
      "opensumi-source": "./src/common/vscode/converter.ts",
      "types": "./lib/common/vscode/converter.d.ts",
      "default": "./lib/common/vscode/converter.js"
    },
    "./vscode/model": {
      "opensumi-source": "./src/common/vscode/model.api.ts",
      "types": "./lib/common/vscode/model.api.d.ts",
      "default": "./lib/common/vscode/model.api.js"
    },
    "./vscode/extension": {
      "opensumi-source": "./src/common/vscode/extension.ts",
      "types": "./lib/common/vscode/extension.d.ts",
      "default": "./lib/common/vscode/extension.js"
    },
    "./sumi/extension": {
      "opensumi-source": "./src/common/sumi/extension.ts",
      "types": "./lib/common/sumi/extension.d.ts",
      "default": "./lib/common/sumi/extension.js"
    },
    "./host/initialize": {
      "opensumi-source": "./src/hosted/ext.process-base.ts",
      "types": "./lib/hosted/ext.process-base.d.ts",
      "default": "./lib/hosted/ext.process-base.js"
    },
    "./host/node": {
      "opensumi-source": "./src/hosted/ext.host.ts",
      "types": "./lib/hosted/ext.host.d.ts",
      "default": "./lib/hosted/ext.host.js"
    },
    "./host/process": {
      "types": "./lib/hosted/ext.process.d.ts",
      "default": "./lib/hosted/ext.process.js"
    },
    "./host/worker": {
      "opensumi-source": "./src/hosted/worker.host-preload.ts",
      "types": "./lib/hosted/worker.host-preload.d.ts",
      "default": "./lib/hosted/worker.host-preload.js"
    },
    "./language/adapters": {
      "opensumi-source": "./src/hosted/language-api.ts",
      "types": "./lib/hosted/language-api.d.ts",
      "default": "./lib/hosted/language-api.js"
    },
    "./node/service": {
      "opensumi-source": "./src/node/extension.service.ts",
      "types": "./lib/node/extension.service.d.ts",
      "default": "./lib/node/extension.service.js"
    },
    "./worker-host.js": "./lib/worker-host.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
