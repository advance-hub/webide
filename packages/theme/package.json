{
  "name": "@opensumi/ide-theme",
  "version": "3.9.0",
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsc --build ../../configs/ts/references/tsconfig.theme.json"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:opensumi/core.git"
  },
  "dependencies": {
    "@opensumi/ide-core-browser": "workspace:*",
    "@opensumi/ide-core-common": "workspace:*",
    "@opensumi/ide-file-service": "workspace:*",
    "@opensumi/di": "^1.8.0",
    "jsonc-parser": "^2.1.0",
    "lodash": "^4.17.21",
    "tslib": "^2.6.2",
    "vscode-textmate": "7.0.1"
  },
  "devDependencies": {
    "@opensumi/ide-dev-tool": "workspace:*",
    "@opensumi/ide-logs": "workspace:*"
  },
  "exports": {
    ".": {
      "opensumi-source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "opensumi-source": "./src/common/theme.service.ts",
      "types": "./lib/common/theme.service.d.ts",
      "default": "./lib/common/theme.service.js"
    },
    "./colors": {
      "opensumi-source": "./src/common/color.ts",
      "types": "./lib/common/color.d.ts",
      "default": "./lib/common/color.js"
    },
    "./color-registry": {
      "opensumi-source": "./src/common/color-registry.ts",
      "types": "./lib/common/color-registry.d.ts",
      "default": "./lib/common/color-registry.js"
    },
    "./icon-registry": {
      "opensumi-source": "./src/common/icon-registry.ts",
      "types": "./lib/common/icon-registry.d.ts",
      "default": "./lib/common/icon-registry.js"
    },
    "./semantic-tokens": {
      "opensumi-source": "./src/common/semantic-tokens-registry.ts",
      "types": "./lib/common/semantic-tokens-registry.d.ts",
      "default": "./lib/common/semantic-tokens-registry.js"
    },
    "./style": {
      "opensumi-source": "./src/common/style.ts",
      "types": "./lib/common/style.d.ts",
      "default": "./lib/common/style.js"
    },
    "./events": {
      "opensumi-source": "./src/common/event.ts",
      "types": "./lib/common/event.d.ts",
      "default": "./lib/common/event.js"
    },
    "./browser": {
      "opensumi-source": "./src/browser/index.ts",
      "types": "./lib/browser/index.d.ts",
      "default": "./lib/browser/index.js"
    },
    "./workbench": {
      "opensumi-source": "./src/browser/workbench.theme.service.ts",
      "types": "./lib/browser/workbench.theme.service.d.ts",
      "default": "./lib/browser/workbench.theme.service.js"
    },
    "./data": {
      "opensumi-source": "./src/browser/theme-data.ts",
      "types": "./lib/browser/theme-data.d.ts",
      "default": "./lib/browser/theme-data.js"
    },
    "./store": {
      "opensumi-source": "./src/browser/theme-store.ts",
      "types": "./lib/browser/theme-store.d.ts",
      "default": "./lib/browser/theme-store.js"
    },
    "./icons": {
      "opensumi-source": "./src/browser/icon.service.ts",
      "types": "./lib/browser/icon.service.d.ts",
      "default": "./lib/browser/icon.service.js"
    },
    "./commands": {
      "opensumi-source": "./src/browser/theme.contribution.ts",
      "types": "./lib/browser/theme.contribution.d.ts",
      "default": "./lib/browser/theme.contribution.js"
    },
    "./semantic-tokens/runtime": {
      "opensumi-source": "./src/browser/semantic-tokens-registry.ts",
      "types": "./lib/browser/semantic-tokens-registry.d.ts",
      "default": "./lib/browser/semantic-tokens-registry.js"
    },
    "./styles/icon.less": {
      "opensumi-source": "./src/browser/icon.less",
      "default": "./lib/browser/icon.less"
    },
    "./package.json": "./package.json"
  }
}
