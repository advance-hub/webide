{
  "name": "@opensumi/ide-keymaps",
  "version": "3.9.0",
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsc --build ../../configs/ts/references/tsconfig.keymaps.json"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:opensumi/core.git"
  },
  "dependencies": {
    "@opensumi/ide-components": "workspace:*",
    "@opensumi/ide-core-browser": "workspace:*",
    "@opensumi/ide-editor": "workspace:*",
    "@opensumi/ide-file-service": "workspace:*",
    "@opensumi/ide-quick-open": "workspace:*",
    "ajv": "^8.17.1",
    "tslib": "^2.6.2",
    "jsonc-parser": "^2.1.0",
    "@opensumi/di": "^1.8.0",
    "fuzzy": "^0.1.3",
    "classnames": "2.5.1",
    "@opensumi/ide-core-common": "workspace:*"
  },
  "devDependencies": {
    "@opensumi/ide-dev-tool": "workspace:*",
    "@opensumi/ide-preferences": "workspace:*"
  },
  "exports": {
    ".": {
      "opensumi-source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./browser": {
      "opensumi-source": "./src/browser/index.ts",
      "types": "./lib/browser/index.d.ts",
      "default": "./lib/browser/index.js"
    },
    "./service": {
      "opensumi-source": "./src/browser/keymaps.service.ts",
      "types": "./lib/browser/keymaps.service.d.ts",
      "default": "./lib/browser/keymaps.service.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  }
}
