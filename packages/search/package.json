{
  "name": "@opensumi/ide-search",
  "version": "3.9.0",
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsc --build ../../configs/ts/references/tsconfig.search.json",
    "watch": "pnpm run build -w"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:opensumi/core.git"
  },
  "dependencies": {
    "@opensumi/ide-components": "workspace:*",
    "@opensumi/ide-connection": "workspace:*",
    "@opensumi/ide-core-browser": "workspace:*",
    "@opensumi/ide-core-common": "workspace:*",
    "@opensumi/ide-core-node": "workspace:*",
    "@opensumi/ide-editor": "workspace:*",
    "@opensumi/ide-file-service": "workspace:*",
    "@opensumi/ide-logs": "workspace:*",
    "@opensumi/ide-main-layout": "workspace:*",
    "@opensumi/ide-monaco": "workspace:*",
    "@opensumi/ide-overlay": "workspace:*",
    "@opensumi/ide-process": "workspace:*",
    "@opensumi/ide-workspace": "workspace:*",
    "@opensumi/ide-workspace-edit": "workspace:*",
    "@opensumi/ripgrep": "^1.4.0",
    "tslib": "^2.6.2",
    "@opensumi/di": "^1.8.0",
    "classnames": "2.5.1",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@opensumi/ide-dev-tool": "workspace:*"
  },
  "exports": {
    ".": {
      "opensumi-source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./browser": {
      "opensumi-source": "./src/browser/index.ts",
      "types": "./lib/browser/index.d.ts",
      "default": "./lib/browser/index.js"
    },
    "./node": {
      "opensumi-source": "./src/node/index.ts",
      "types": "./lib/node/index.d.ts",
      "default": "./lib/node/index.js"
    },
    "./service": {
      "opensumi-source": "./src/browser/search.service.ts",
      "types": "./lib/browser/search.service.d.ts",
      "default": "./lib/browser/search.service.js"
    },
    "./nodes": {
      "opensumi-source": "./src/browser/tree/tree-node.defined.ts",
      "types": "./lib/browser/tree/tree-node.defined.d.ts",
      "default": "./lib/browser/tree/tree-node.defined.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  }
}
