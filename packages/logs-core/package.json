{
  "name": "@opensumi/ide-logs",
  "version": "3.9.0",
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsc --build ../../configs/ts/references/tsconfig.logs-core.json"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:opensumi/core.git"
  },
  "dependencies": {
    "@opensumi/ide-connection": "workspace:*",
    "@opensumi/ide-core-browser": "workspace:*",
    "@opensumi/ide-core-common": "workspace:*",
    "@opensumi/ide-core-node": "workspace:*",
    "@vscode/spdlog": "^0.15.8",
    "compressing": "^1.10.0",
    "tslib": "^2.6.2",
    "fs-extra": "^11.2.0",
    "@opensumi/di": "^1.8.0"
  },
  "devDependencies": {
    "@opensumi/ide-dev-tool": "workspace:*"
  },
  "exports": {
    ".": {
      "opensumi-source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./browser": {
      "opensumi-source": "./src/browser/index.ts",
      "types": "./lib/browser/index.d.ts",
      "default": "./lib/browser/index.js"
    },
    "./node": {
      "opensumi-source": "./src/node/index.ts",
      "types": "./lib/node/index.d.ts",
      "default": "./lib/node/index.js"
    },
    "./node/manager": {
      "opensumi-source": "./src/node/log-manager.ts",
      "types": "./lib/node/log-manager.d.ts",
      "default": "./lib/node/log-manager.js"
    },
    "./package.json": "./package.json"
  }
}
