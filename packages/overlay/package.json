{
  "name": "@opensumi/ide-overlay",
  "version": "3.9.0",
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsc --build ../../configs/ts/references/tsconfig.overlay.json"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:opensumi/core.git"
  },
  "dependencies": {
    "@opensumi/ide-components": "workspace:*",
    "@opensumi/ide-core-browser": "workspace:*",
    "@opensumi/ide-core-common": "workspace:*",
    "@opensumi/ide-theme": "workspace:*",
    "tslib": "^2.8.1",
    "@opensumi/di": "^1.8.0",
    "@opensumi/monaco-editor-core": "0.54.0-patch.2"
  },
  "devDependencies": {
    "@opensumi/ide-dev-tool": "workspace:*"
  },
  "exports": {
    ".": {
      "opensumi-source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./browser": {
      "opensumi-source": "./src/browser/index.ts",
      "types": "./lib/browser/index.d.ts",
      "default": "./lib/browser/index.js"
    },
    "./messages": {
      "opensumi-source": "./src/browser/message.service.tsx",
      "types": "./lib/browser/message.service.d.ts",
      "default": "./lib/browser/message.service.js"
    },
    "./context-menu": {
      "opensumi-source": "./src/browser/ctx-menu/ctx-menu.service.ts",
      "types": "./lib/browser/ctx-menu/ctx-menu.service.d.ts",
      "default": "./lib/browser/ctx-menu/ctx-menu.service.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  }
}
