{
  "name": "@opensumi/ide-core-electron-main",
  "version": "3.9.0",
  "files": [
    "lib",
    "src",
    "browser-preload"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsc --build ../../configs/ts/references/tsconfig.core-electron-main.json"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:opensumi/core.git"
  },
  "dependencies": {
    "@opensumi/ide-core-common": "workspace:*",
    "tree-kill": "^1.2.2",
    "tslib": "^2.8.1",
    "@opensumi/di": "^1.8.0",
    "fs-extra": "^11.4.1",
    "vscode-oniguruma": "2.0.1"
  },
  "peerDependencies": {
    "electron": "*"
  },
  "devDependencies": {
    "@opensumi/ide-dev-tool": "workspace:*"
  },
  "exports": {
    ".": {
      "opensumi-source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./module": {
      "opensumi-source": "./src/electron-main-module.ts",
      "types": "./lib/electron-main-module.d.ts",
      "default": "./lib/electron-main-module.js"
    },
    "./types": {
      "opensumi-source": "./src/bootstrap/types.ts",
      "types": "./lib/bootstrap/types.d.ts",
      "default": "./lib/bootstrap/types.js"
    },
    "./protocol": {
      "opensumi-source": "./src/bootstrap/services/protocol.ts",
      "types": "./lib/bootstrap/services/protocol.d.ts",
      "default": "./lib/bootstrap/services/protocol.js"
    },
    "./browser-preload.js": "./browser-preload/index.js",
    "./package.json": "./package.json"
  }
}
