{
  "name": "@opensumi/ide-preferences",
  "version": "3.9.0",
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsc --build ../../configs/ts/references/tsconfig.preferences.json"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:opensumi/core.git"
  },
  "dependencies": {
    "@opensumi/events": "^1.0.0",
    "@opensumi/ide-components": "workspace:*",
    "@opensumi/ide-core-browser": "workspace:*",
    "@opensumi/ide-core-common": "workspace:*",
    "@opensumi/ide-editor": "workspace:*",
    "@opensumi/ide-file-service": "workspace:*",
    "@opensumi/ide-monaco": "workspace:*",
    "@opensumi/ide-workspace": "workspace:*",
    "react-virtualized-auto-sizer": "^1.0.2",
    "tslib": "^2.8.1",
    "@opensumi/di": "^1.8.0",
    "@opensumi/monaco-editor-core": "0.54.0-patch.2",
    "classnames": "2.5.1",
    "lodash": "^4.17.21",
    "jsonc-parser": "^2.1.0",
    "react-virtuoso": "^4.18.19"
  },
  "devDependencies": {
    "@opensumi/ide-dev-tool": "workspace:*"
  },
  "exports": {
    ".": {
      "opensumi-source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./browser": {
      "opensumi-source": "./src/browser/index.ts",
      "types": "./lib/browser/index.d.ts",
      "default": "./lib/browser/index.js"
    },
    "./folder-provider": {
      "opensumi-source": "./src/browser/folder-file-preference-provider.ts",
      "types": "./lib/browser/folder-file-preference-provider.d.ts",
      "default": "./lib/browser/folder-file-preference-provider.js"
    },
    "./user-storage": {
      "opensumi-source": "./src/browser/userstorage/index.ts",
      "types": "./lib/browser/userstorage/index.d.ts",
      "default": "./lib/browser/userstorage/index.js"
    },
    "./settings": {
      "opensumi-source": "./src/browser/preference-settings.service.ts",
      "types": "./lib/browser/preference-settings.service.d.ts",
      "default": "./lib/browser/preference-settings.service.js"
    },
    "./contribution": {
      "opensumi-source": "./src/browser/preference-contribution.ts",
      "types": "./lib/browser/preference-contribution.d.ts",
      "default": "./lib/browser/preference-contribution.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  }
}
